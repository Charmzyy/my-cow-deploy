# Copy to .env on the server (cp .env.example .env && nano .env) and fill in every "change-me".
# .env is never committed: it holds the app key and database password.

# --- Used by compose (image names, tags, domain) ---
HUB_USER=charmzzy
# deploy.sh rewrites these three lines on every release; set them by hand only for the first start
REST_TAG=v12
CLIENT_TAG=v13
# Needs a tag built AFTER the arm64 change to CI (older cow-py tags are amd64-only)
PY_TAG=v1
# The address people open. Goes into ear-tag QR stickers and certificate QR codes: pick it once.
DOMAIN=app.farmops.co.ke

# --- Laravel (passed into the app container via env_file) ---
APP_NAME=MyCow
APP_ENV=production
# docker compose run --rm --no-deps app php artisan key:generate --show   then paste the output here
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.farmops.co.ke
FRONTEND_URL=https://app.farmops.co.ke
CORS_ALLOWED_ORIGINS=https://app.farmops.co.ke
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cowbreed
DB_USERNAME=root
# Becomes MySQL's root password on the FIRST start of an empty volume only. Make it long:
#   openssl rand -base64 24
DB_PASSWORD=change-me

# The model runs next to the app now (no more Render cold starts)
PY_PREDICT_URL=http://model:8003/predict

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# No real email yet: messages are written to the app log (docker compose logs app)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@farmops.co.ke
MAIL_FROM_NAME=MyCow

# --- Backups (backup.sh) ---
# rclone remote + bucket for off-server copies (see RUNBOOK-vps.md, phase 7)
BACKUP_REMOTE=r2:mycow-backups
